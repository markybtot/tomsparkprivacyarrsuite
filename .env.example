# ==========================================
# TOM SPARK'S PRIVACY BOX CONFIG (No-VPN edition)
# Created by Tom Spark | youtube.com/@TomSparkReviews
# ==========================================
# Copy this file to .env and fill in your settings
# OR just run setup.sh / Setup-PrivacyBox.bat and it will create it for you!

# --- SYSTEM SETTINGS ---
# Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/London
ROOT_DIR=.

# --- PLEX ---
# Claim token from https://plex.tv/claim (expires 4 minutes after you generate it).
# Only needed for the very first start; links the server to your Plex account.
PLEX_CLAIM=

# --- NOTIFIARR (optional, only needed for the notifications profile) ---
# NOTIFIARR_API_KEY="your_notifiarr_api_key"
